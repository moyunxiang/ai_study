{
  "threads": [
    {"key": "representation", "name": "无监督表示学习", "blurb": "没有标签时，怎样从数据里自己找出低维结构、能量形状或可复用的特征。", "from": null, "aka": ["表示学习", "Representation Learning", "Unsupervised Representation Learning", "无监督学习", "降维", "能量模型", "EBM", "自编码器", "特征学习"]},
    {"key": "neural-net", "name": "神经网络与反向传播", "blurb": "怎样用多层可微的神经元网络表示复杂函数，并用梯度把权重学出来。", "from": null, "aka": ["神经网络", "Neural Networks", "人工神经网络", "ANN", "反向传播", "Backpropagation", "BP算法", "多层感知机", "MLP", "连接主义", "Connectionism"]},
    {"key": "recurrent", "name": "循环网络与记忆", "blurb": "让网络一步步读序列并记住前文，同时解决长序列上梯度消失的难题。", "from": "neural-net", "via": "backprop", "aka": ["RNN", "循环神经网络", "递归神经网络", "Recurrent Neural Network", "LSTM", "长短期记忆", "GRU", "记忆网络", "Memory"]},
    {"key": "linear-rnn", "name": "线性循环与状态空间", "blurb": "用可并行训练的线性递推替代注意力，在长序列上兼顾速度与记忆。", "from": "recurrent", "via": "fast-weights", "aka": ["SSM", "状态空间模型", "State Space Model", "线性RNN", "Linear RNN", "线性注意力", "Linear Attention", "Mamba", "次二次架构", "Subquadratic", "Delta规则", "DeltaNet", "测试时记忆", "Test-Time Memorization", "高效序列模型"]},
    {"key": "transfer", "name": "迁移与元学习", "blurb": "让模型把学过的本领带到新任务、连续学而不忘，并自动选超参数和结构。", "from": "neural-net", "via": "backprop", "aka": ["迁移学习", "Transfer Learning", "元学习", "Meta-Learning", "学会学习", "Learning to Learn", "持续学习", "Continual Learning", "终身学习", "Lifelong Learning", "灾难性遗忘", "Catastrophic Forgetting", "小样本学习", "Few-Shot Learning", "AutoML", "超参数优化", "HPO", "神经架构搜索", "NAS", "测试时适应", "TTA", "领域适应", "Domain Adaptation"]},
    {"key": "recipe", "name": "深层训练配方", "blurb": "初始化、激活函数、归一化、残差与正则化：让很深的网络训得稳又不过拟合。", "from": "neural-net", "via": "backprop", "aka": ["训练技巧", "Training Tricks", "初始化", "Initialization", "激活函数", "Activation Function", "归一化", "Normalization", "BatchNorm", "LayerNorm", "残差连接", "Residual Connection", "正则化", "Regularization", "深度学习调参经验"]},
    {"key": "graph", "name": "图与几何深度学习", "blurb": "输入是图、集合或带旋转平移对称性的数据时，怎样把这些结构写进网络。", "from": "neural-net", "aka": ["GNN", "图神经网络", "Graph Neural Network", "图学习", "Graph Learning", "图表示学习", "几何深度学习", "Geometric Deep Learning", "等变网络", "Equivariant Network", "消息传递", "Message Passing"]},
    {"key": "optimizer", "name": "优化器与学习率", "blurb": "怎样沿着梯度更快、更稳地走到好的解，并在超大批量和大模型上依然有效。", "from": null, "aka": ["优化器", "Optimizer", "Optimization", "优化算法", "梯度下降", "Gradient Descent", "SGD", "Adam", "学习率调度", "LR Schedule", "二阶优化", "Second-Order Optimization", "进化算法", "Evolutionary Algorithm", "黑箱优化", "Black-Box Optimization", "无梯度优化", "Derivative-Free Optimization"]},
    {"key": "probabilistic", "name": "概率模型与不确定性", "blurb": "用概率描述数据和模型自身的不确定，并用采样、变分或集成来近似计算。", "from": null, "aka": ["概率机器学习", "Probabilistic Machine Learning", "贝叶斯方法", "Bayesian Methods", "贝叶斯深度学习", "Bayesian Deep Learning", "不确定性估计", "Uncertainty Quantification", "UQ", "概率图模型", "PGM", "变分推断", "MCMC"]},
    {"key": "statlearn", "name": "经典统计学习", "blurb": "在小数据上用线性模型、核方法和正则化做分类回归，并可靠地选模型。", "from": null, "aka": ["统计学习", "Statistical Learning", "传统机器学习", "Classical Machine Learning", "经典机器学习", "线性模型", "核方法", "Kernel Methods", "SVM", "支持向量机", "正则化回归"]},
    {"key": "trees", "name": "决策树与集成", "blurb": "把很多棵简单的决策树组合起来，在表格数据上得到又准又快的预测。", "from": "statlearn", "aka": ["树模型", "Tree Models", "GBDT", "梯度提升树", "Gradient Boosting", "集成学习", "Ensemble Learning", "随机森林", "表格数据", "Tabular Data", "Tabular ML", "XGBoost"]},
    {"key": "theory", "name": "泛化与学习理论", "blurb": "什么条件下能从样本学到规律，参数远多于数据的大网络又为何仍能泛化。", "from": "statlearn", "via": "vc-dimension", "aka": ["学习理论", "Learning Theory", "机器学习理论", "深度学习理论", "Deep Learning Theory", "泛化理论", "Generalization Theory", "统计学习理论", "PAC", "VC维", "过参数化", "Overparameterization", "双下降", "Double Descent", "NTK", "训练动力学", "Training Dynamics"]}
  ],
