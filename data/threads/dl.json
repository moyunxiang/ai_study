{
  "threads": [
    {"key": "representation", "name": "无监督表示学习", "blurb": "没有标签时，怎样从数据里自己找出低维结构、能量形状或可复用的特征。", "from": null},
    {"key": "neural-net", "name": "神经网络与反向传播", "blurb": "怎样用多层可微的神经元网络表示复杂函数，并用梯度把权重学出来。", "from": null},
    {"key": "recurrent", "name": "循环网络与记忆", "blurb": "让网络一步步读序列并记住前文，同时解决长序列上梯度消失的难题。", "from": "neural-net", "via": "backprop"},
    {"key": "linear-rnn", "name": "线性循环与状态空间", "blurb": "用可并行训练的线性递推替代注意力，在长序列上兼顾速度与记忆。", "from": "recurrent", "via": "fast-weights"},
    {"key": "transfer", "name": "迁移与元学习", "blurb": "让模型把学过的本领带到新任务、连续学而不忘，并自动选超参数和结构。", "from": "neural-net", "via": "backprop"},
    {"key": "recipe", "name": "深层训练配方", "blurb": "初始化、激活函数、归一化、残差与正则化：让很深的网络训得稳又不过拟合。", "from": "neural-net", "via": "backprop"},
    {"key": "graph", "name": "图与几何深度学习", "blurb": "输入是图、集合或带旋转平移对称性的数据时，怎样把这些结构写进网络。", "from": "neural-net"},
    {"key": "optimizer", "name": "优化器与学习率", "blurb": "怎样沿着梯度更快、更稳地走到好的解，并在超大批量和大模型上依然有效。", "from": null},
    {"key": "probabilistic", "name": "概率模型与不确定性", "blurb": "用概率描述数据和模型自身的不确定，并用采样、变分或集成来近似计算。", "from": null},
    {"key": "statlearn", "name": "经典统计学习", "blurb": "在小数据上用线性模型、核方法和正则化做分类回归，并可靠地选模型。", "from": null},
    {"key": "trees", "name": "决策树与集成", "blurb": "把很多棵简单的决策树组合起来，在表格数据上得到又准又快的预测。", "from": "statlearn"},
    {"key": "theory", "name": "泛化与学习理论", "blurb": "什么条件下能从样本学到规律，参数远多于数据的大网络又为何仍能泛化。", "from": "statlearn", "via": "vc-dimension"}
  ],
