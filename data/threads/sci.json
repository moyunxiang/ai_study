{
  "threads": [
    {
      "key": "auto-science",
      "name": "自动化科研",
      "blurb": "让机器自己提出假设、做实验、写结论，把科研流程交给AI。",
      "from": null
    },
    {
      "key": "math-discovery",
      "name": "数学与算法发现",
      "blurb": "让机器提出新猜想、找出更好的构造和更快的算法。",
      "from": "auto-science",
      "via": "dendral"
    },
    {
      "key": "law-discovery",
      "name": "从数据发现定律",
      "blurb": "从观测数据里自动找出简洁的方程和物理定律。",
      "from": "auto-science",
      "via": "dendral"
    },
    {
      "key": "medicine",
      "name": "医疗诊断",
      "blurb": "让AI读医学影像、回答临床问题、和病人对话给出诊断。",
      "from": null
    },
    {
      "key": "theorem-proving",
      "name": "定理证明",
      "blurb": "让计算机严格证明数学定理，从穷举验证到神经网络自动写证明。",
      "from": null
    },
    {
      "key": "protein-structure",
      "name": "蛋白质结构预测",
      "blurb": "只给氨基酸序列，算出蛋白质折叠成的三维形状及其与其他分子的结合。",
      "from": null
    },
    {
      "key": "protein-design",
      "name": "蛋白质设计",
      "blurb": "反过来按需求设计出自然界没有、但能折叠并起作用的新蛋白。",
      "from": "protein-structure",
      "via": "rosetta"
    },
    {
      "key": "atomistic",
      "name": "原子模拟与材料",
      "blurb": "用神经网络代替昂贵的量子力学计算，模拟原子并发现新材料。",
      "from": null
    },
    {
      "key": "molecule-drug",
      "name": "分子设计与药物",
      "blurb": "预测分子性质、规划合成路线，生成和筛选候选药物。",
      "from": null
    },
    {
      "key": "physics-sim",
      "name": "物理模拟与控制",
      "blurb": "用神经网络求解方程、加速物理仿真，并控制真实物理装置。",
      "from": null
    },
    {
      "key": "bio-sequence",
      "name": "生物序列模型",
      "blurb": "像读语言一样读蛋白质和DNA序列，预测功能和变异影响。",
      "from": null
    },
    {
      "key": "weather",
      "name": "天气与气候预报",
      "blurb": "用数据驱动的模型做天气预报，比数值预报更快甚至更准。",
      "from": null
    }
  ],
