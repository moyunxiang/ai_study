{
  "threads": [
    {
      "key": "auto-science",
      "name": "自动化科研",
      "blurb": "让机器自己提出假设、做实验、写结论，把科研流程交给AI。",
      "aka": ["AI科学家", "AI Scientist", "自动科研", "自主科学发现", "AI for Science", "AI4Science", "自驱动实验室", "Self-driving Lab", "科研智能体", "Autonomous Discovery"],
      "from": null
    },
    {
      "key": "math-discovery",
      "name": "数学与算法发现",
      "blurb": "让机器提出新猜想、找出更好的构造和更快的算法。",
      "aka": ["AI数学发现", "算法发现", "进化式程序搜索", "LLM进化搜索", "Evolutionary Program Search", "AI for Math", "矩阵乘法发现", "猜想生成"],
      "from": "auto-science",
      "via": "dendral"
    },
    {
      "key": "law-discovery",
      "name": "从数据发现定律",
      "blurb": "从观测数据里自动找出简洁的方程和物理定律。",
      "aka": ["符号回归", "Symbolic Regression", "方程发现", "科学定律发现", "Equation Discovery", "稀疏回归", "Law Discovery"],
      "from": "auto-science",
      "via": "dendral"
    },
    {
      "key": "medicine",
      "name": "医疗诊断",
      "blurb": "让AI读医学影像、回答临床问题、和病人对话给出诊断。",
      "aka": ["医疗AI", "AI医疗", "医学影像AI", "Medical AI", "临床大模型", "AI诊断", "Medical Imaging", "医学大模型", "Clinical LLM"],
      "from": null
    },
    {
      "key": "theorem-proving",
      "name": "定理证明",
      "blurb": "让计算机严格证明数学定理，从穷举验证到神经网络自动写证明。",
      "aka": ["自动定理证明", "ATP", "Automated Theorem Proving", "形式化数学", "Formal Math", "Lean证明", "神经定理证明", "形式化证明", "Autoformalization", "自动形式化", "AI数学奥赛", "IMO AI", "交互式定理证明", "ITP"],
      "from": null
    },
    {
      "key": "protein-structure",
      "name": "蛋白质结构预测",
      "blurb": "只给氨基酸序列，算出蛋白质折叠成的三维形状及其与其他分子的结合。",
      "aka": ["蛋白质结构预测", "Protein Structure Prediction", "AlphaFold", "折叠预测", "Protein Folding", "蛋白质折叠", "结构生物学AI", "生物分子结构预测"],
      "from": null
    },
    {
      "key": "protein-design",
      "name": "蛋白质设计",
      "blurb": "反过来按需求设计出自然界没有、但能折叠并起作用的新蛋白。",
      "aka": ["蛋白质设计", "Protein Design", "从头设计蛋白", "De Novo Protein Design", "结合蛋白设计", "Binder Design", "抗体设计", "Antibody Design", "生成式蛋白设计"],
      "from": "protein-structure",
      "via": "rosetta"
    },
    {
      "key": "atomistic",
      "name": "原子模拟与材料",
      "blurb": "用神经网络代替昂贵的量子力学计算，模拟原子并发现新材料。",
      "aka": ["机器学习势函数", "MLIP", "Machine Learning Interatomic Potential", "力场", "Force Field", "材料发现", "Materials Discovery", "材料AI", "通用原子模型", "等变神经网络势", "分子动力学", "DFT替代"],
      "from": null
    },
    {
      "key": "molecule-drug",
      "name": "分子设计与药物",
      "blurb": "预测分子性质、规划合成路线，生成和筛选候选药物。",
      "aka": ["AI药物发现", "Drug Discovery", "分子生成", "逆合成", "Retrosynthesis", "分子性质预测", "药物设计", "分子对接", "Molecular Docking", "AIDD", "计算化学"],
      "from": null
    },
    {
      "key": "physics-sim",
      "name": "物理模拟与控制",
      "blurb": "用神经网络求解方程、加速物理仿真，并控制真实物理装置。",
      "aka": ["神经算子", "Neural Operator", "PDE求解", "物理仿真", "AI物理仿真", "Neural PDE Solver", "科学机器学习", "SciML", "代理模型", "Surrogate Model", "PINN", "基础模型物理"],
      "from": null
    },
    {
      "key": "bio-sequence",
      "name": "生物序列模型",
      "blurb": "像读语言一样读蛋白质和DNA序列，预测功能和变异影响。",
      "aka": ["蛋白质语言模型", "Protein Language Model", "PLM", "基因组语言模型", "DNA语言模型", "Genomic Language Model", "单细胞基础模型", "生物基础模型", "Biological Foundation Model", "虚拟细胞", "Virtual Cell"],
      "from": null
    },
    {
      "key": "weather",
