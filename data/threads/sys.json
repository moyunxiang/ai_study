{
 "threads": [
  {
   "key": "framework",
   "name": "自动微分框架",
   "blurb": "让电脑自动算出梯度，研究者只写前向计算，不再手推公式、手写GPU代码。",
   "from": null
  },
  {
   "key": "compiler",
   "name": "编译器与高性能算子",
   "blurb": "把模型里的运算变成在GPU等硬件上跑得最快的内核代码，注意力计算是重点。",
   "from": "framework"
  },
  {
   "key": "ecosystem",
   "name": "开源模型库",
   "blurb": "把论文里的模型做成别人一行代码就能下载、复现和改写的开源库。",
   "from": "framework",
   "via": "caffe"
  },
  {
   "key": "tools",
   "name": "科学计算与研究工具",
   "blurb": "矩阵运算、经典机器学习和交互式实验的基础工具，以及怎样管好实验和系统。",
   "from": null
  },
  {
   "key": "compress",
   "name": "模型压缩与蒸馏",
   "blurb": "把训好的大模型变小变快：剪掉冗余连接，或让小模型模仿大模型。",
   "from": null
  },
  {
   "key": "quant",
   "name": "低比特量化",
   "blurb": "用8位、4位甚至1位数字代替32位浮点，让模型省显存、算得快又不掉精度。",
   "from": "compress",
   "via": "deep-compression"
  },
  {
   "key": "distributed",
   "name": "分布式与数据并行",
   "blurb": "数据和计算一台机器放不下时，怎样把它们分给成百上千台机器一起做。",
   "from": null
  },
  {
   "key": "bigtrain",
   "name": "大模型并行训练",
   "blurb": "模型大到单卡装不下时，怎样切分模型、省显存、降精度，在万卡集群上稳定训练。",
   "from": "distributed"
  },
  {
   "key": "local",
   "name": "本地与端侧部署",
   "blurb": "让模型离开数据中心，跑在手机、笔记本和浏览器里。",
   "from": null
  },
  {
   "key": "decoding",
   "name": "解码与生成控制",
   "blurb": "模型逐词生成时怎样选词、守住输出格式，并一次多猜几个词来提速。",
   "from": null,
   "via": "transformer"
  },
  {
   "key": "peft",
   "name": "参数高效微调",
   "blurb": "只训练极少量参数或合并已有权重，就让大模型学会新任务。",
   "from": null,
   "via": "bert"
  },
  {
   "key": "serving",
   "name": "推理服务引擎",
   "blurb": "同时服务海量请求时，怎样调度批次、管好KV缓存，压低每个token的成本。",
   "from": null
  }
 ],
