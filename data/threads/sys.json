{
 "threads": [
  {
   "key": "framework",
   "name": "自动微分框架",
   "blurb": "让电脑自动算出梯度，研究者只写前向计算，不再手推公式、手写GPU代码。",
   "aka": ["深度学习框架", "DL framework", "Deep Learning Framework", "自动微分", "autodiff", "AD", "autograd", "动态图", "静态图", "计算图", "computational graph"],
   "from": null
  },
  {
   "key": "compiler",
   "name": "编译器与高性能算子",
   "blurb": "把模型里的运算变成在GPU等硬件上跑得最快的内核代码，注意力计算是重点。",
   "aka": ["深度学习编译器", "DL compiler", "AI编译器", "算子", "算子优化", "kernel", "CUDA kernel", "GPU kernel", "内核", "算子融合", "kernel fusion", "注意力内核", "attention kernel", "IO感知注意力"],
   "from": "framework"
  },
  {
   "key": "ecosystem",
   "name": "开源模型库",
   "blurb": "把论文里的模型做成别人一行代码就能下载、复现和改写的开源库。",
   "aka": ["开源生态", "open-source ecosystem", "模型库", "model hub", "模型仓库", "预训练模型库", "model zoo", "开源社区"],
   "from": "framework",
   "via": "caffe"
  },
  {
   "key": "tools",
   "name": "科学计算与研究工具",
   "blurb": "矩阵运算、经典机器学习和交互式实验的基础工具，以及怎样管好实验和系统。",
   "aka": ["科学计算", "scientific computing", "开发工具", "developer tools", "MLOps", "实验管理", "experiment tracking", "数值计算", "线性代数库"],
   "from": null
  },
  {
   "key": "compress",
   "name": "模型压缩与蒸馏",
   "blurb": "把训好的大模型变小变快：剪掉冗余连接，或让小模型模仿大模型。",
   "aka": ["模型压缩", "model compression", "知识蒸馏", "KD", "knowledge distillation", "蒸馏", "distillation", "剪枝", "pruning", "稀疏化", "sparsity", "结构化剪枝", "模型轻量化", "小模型"],
   "from": null
  },
  {
   "key": "quant",
   "name": "低比特量化",
   "blurb": "用8位、4位甚至1位数字代替32位浮点，让模型省显存、算得快又不掉精度。",
   "aka": ["量化", "quantization", "模型量化", "低比特", "low-bit", "PTQ", "训练后量化", "QAT", "量化感知训练", "INT8", "INT4", "4bit", "W4A16", "W8A8", "二值网络", "1-bit"],
   "from": "compress",
   "via": "deep-compression"
  },
  {
   "key": "distributed",
   "name": "分布式与数据并行",
   "blurb": "数据和计算一台机器放不下时，怎样把它们分给成百上千台机器一起做。",
   "aka": ["分布式训练", "distributed training", "数据并行", "data parallelism", "DP", "DDP", "All-Reduce", "参数服务器", "联邦学习", "去中心化训练", "decentralized training", "低通信训练"],
   "from": null
  },
  {
   "key": "bigtrain",
   "name": "大模型并行训练",
   "blurb": "模型大到单卡装不下时，怎样切分模型、省显存、降精度，在万卡集群上稳定训练。",
   "aka": ["大模型训练", "LLM training infra", "模型并行", "model parallelism", "张量并行", "TP", "流水线并行", "PP", "pipeline parallelism", "3D并行", "序列并行", "SP", "专家并行", "EP", "混合精度", "显存优化", "万卡训练", "RL训练框架", "RL infra"],
   "from": "distributed"
  },
  {
   "key": "local",
   "name": "本地与端侧部署",
   "blurb": "让模型离开数据中心，跑在手机、笔记本和浏览器里。",
   "aka": ["端侧部署", "端侧AI", "on-device AI", "edge AI", "边缘部署", "本地部署", "本地大模型", "local LLM", "本地推理", "离线推理", "移动端推理", "手机大模型"],
   "from": null
  },
  {
   "key": "decoding",
   "name": "解码与生成控制",
   "blurb": "模型逐词生成时怎样选词、守住输出格式，并一次多猜几个词来提速。",
   "aka": ["解码策略", "decoding", "采样策略", "sampling", "推测解码", "投机解码", "投机采样", "speculative decoding", "并行解码", "约束解码", "结构化输出", "structured output", "constrained decoding", "JSON mode"],
   "from": null,
   "via": "transformer"
  },
  {
   "key": "peft",
   "name": "参数高效微调",
   "blurb": "只训练极少量参数或合并已有权重，就让大模型学会新任务。",
   "aka": ["PEFT", "Parameter-Efficient Fine-Tuning", "高效微调", "轻量微调", "低秩适配", "LoRA微调", "适配器", "adapter", "模型合并", "model merging", "权重合并", "模型融合", "低显存训练"],
   "from": null,
   "via": "bert"
  },
  {
   "key": "serving",
   "name": "推理服务引擎",
   "blurb": "同时服务海量请求时，怎样调度批次、管好KV缓存，压低每个token的成本。",
   "aka": ["推理服务", "LLM serving", "inference serving", "推理引擎", "inference engine", "推理加速", "推理优化", "inference optimization", "KV缓存", "KV cache", "KV缓存压缩", "连续批处理", "continuous batching", "PD分离", "预填充解码分离", "前缀缓存", "prefix caching"],
   "from": null
  }
