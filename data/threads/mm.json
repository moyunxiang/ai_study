{
  "threads": [
    {
      "key": "caption",
      "name": "图像描述与问答",
      "blurb": "让模型看图说一句话、回答关于图的问题，靠注意力找到该看的地方。",
      "from": null
    },
    {
      "key": "grounding",
      "name": "指代与定位",
      "blurb": "把语言里说的东西对应到图中具体的框或区域上。",
      "from": "caption",
      "via": "show-and-tell"
    },
    {
      "key": "vlp",
      "name": "视觉语言预训练",
      "blurb": "先在大量图文数据上预训练一个共用模型，再迁移到各种图文任务。",
      "from": "caption",
      "via": "bottom-up-top-down"
    },
    {
      "key": "video",
      "name": "视频理解",
      "blurb": "让模型看懂一段视频的时间过程，并能就视频内容对话。",
      "from": "vlp"
    },
    {
      "key": "doc",
      "name": "文档与OCR",
      "blurb": "不经传统OCR流水线，直接读懂文档、截图和表格里的文字与版面。",
      "from": "vlp"
    },
    {
      "key": "embed",
      "name": "图文对比对齐",
      "blurb": "把图像和文字映射到同一空间，让对得上的图文靠近，实现零样本识别。",
      "from": null
    },
    {
      "key": "bridge",
      "name": "视觉接入大模型",
      "blurb": "给已训练好的语言模型接上视觉编码器，让它能读图并按指令回答。",
      "from": "embed",
      "via": "clip"
    },
    {
      "key": "open-vlm",
      "name": "开源VLM配方",
      "blurb": "用公开数据和模型复现并追赶商业VLM，摸清分辨率、编码器等设计选择。",
      "from": "bridge",
      "via": "llava-1.5"
    },
    {
      "key": "reasoning",
      "name": "多模态推理",
      "blurb": "让模型对图像做多步思考、空间推理，并能用视觉完成智能体任务。",
      "from": "open-vlm"
    },
    {
      "key": "unified",
      "name": "理解与生成统一",
      "blurb": "用一个模型既能看懂图像，又能生成图像。",
      "from": "bridge"
    },
    {
      "key": "omni",
      "name": "原生全模态",
      "blurb": "把文字、图像、音频放进同一个模型端到端处理，支持实时语音视频交互。",
      "from": "bridge",
      "via": "gpt-4v"
    }
  ],
