{
  "threads": [
    {
      "key": "caption",
      "name": "图像描述与问答",
      "aka": ["图像描述", "Image Captioning", "看图说话", "视觉问答", "VQA", "Visual Question Answering", "图像字幕"],
      "blurb": "让模型看图说一句话、回答关于图的问题，靠注意力找到该看的地方。",
      "from": null
    },
    {
      "key": "grounding",
      "name": "指代与定位",
      "aka": ["视觉定位", "Visual Grounding", "指代表达", "Referring Expression", "REC", "开放词表检测", "Open-Vocabulary Detection", "短语定位", "推理分割"],
      "blurb": "把语言里说的东西对应到图中具体的框或区域上。",
      "from": "caption",
      "via": "show-and-tell"
    },
    {
      "key": "vlp",
      "name": "视觉语言预训练",
      "aka": ["VLP", "Vision-Language Pre-training", "视觉语言预训练模型", "图文预训练", "多模态预训练", "单流/双流模型"],
      "blurb": "先在大量图文数据上预训练一个共用模型，再迁移到各种图文任务。",
      "from": "caption",
      "via": "bottom-up-top-down"
    },
    {
      "key": "video",
      "name": "视频理解",
      "aka": ["视频理解", "Video Understanding", "Video LLM", "视频大模型", "视频多模态大模型", "长视频理解", "流式视频理解", "Streaming Video", "视频问答", "VideoQA"],
      "blurb": "让模型看懂一段视频的时间过程，并能就视频内容对话。",
      "from": "vlp"
    },
    {
      "key": "doc",
      "name": "文档与OCR",
      "aka": ["文档理解", "Document Understanding", "OCR-free", "无OCR", "文档解析", "Document Parsing", "OCR 2.0", "视觉文本压缩", "光学压缩", "文档检索", "截图理解"],
      "blurb": "不经传统OCR流水线，直接读懂文档、截图和表格里的文字与版面。",
      "from": "vlp"
    },
    {
      "key": "embed",
      "name": "图文对比对齐",
      "aka": ["图文对比学习", "对比语言-图像预训练", "Contrastive Language-Image Pre-training", "CLIP系列", "视觉语言嵌入", "图文检索", "零样本分类", "视觉编码器", "Vision Encoder", "多模态嵌入"],
      "blurb": "把图像和文字映射到同一空间，让对得上的图文靠近，实现零样本识别。",
      "from": null
    },
    {
      "key": "bridge",
      "name": "视觉接入大模型",
      "aka": ["MLLM", "多模态大语言模型", "Multimodal Large Language Model", "LMM", "大型多模态模型", "LVLM", "视觉指令微调", "Visual Instruction Tuning", "视觉连接器", "Connector", "Projector", "Q-Former"],
      "blurb": "给已训练好的语言模型接上视觉编码器，让它能读图并按指令回答。",
      "from": "embed",
      "via": "clip"
    },
    {
      "key": "open-vlm",
      "name": "开源VLM配方",
      "aka": ["开源VLM", "Open VLM", "开源多模态大模型", "VLM", "视觉语言模型", "Vision-Language Model", "任意分辨率", "AnyRes", "动态分辨率", "视觉token压缩", "多模态幻觉"],
      "blurb": "用公开数据和模型复现并追赶商业VLM，摸清分辨率、编码器等设计选择。",
      "from": "bridge",
      "via": "llava-1.5"
    },
    {
      "key": "reasoning",
      "name": "多模态推理",
      "aka": ["多模态推理", "Multimodal Reasoning", "视觉推理", "Visual Reasoning", "多模态R1", "Multimodal R1", "用图像思考", "Thinking with Images", "空间智能", "空间推理", "Spatial Reasoning", "Spatial Intelligence", "视觉智能体"],
      "blurb": "让模型对图像做多步思考、空间推理，并能用视觉完成智能体任务。",
      "from": "open-vlm"
    },
    {
      "key": "unified",
      "name": "理解与生成统一",
      "aka": ["统一多模态模型", "Unified Multimodal Model", "UMM", "理解生成一体化", "Any-to-Any", "任意模态生成", "多模态生成", "统一视觉分词器", "Unified Tokenizer"],
      "blurb": "用一个模型既能看懂图像，又能生成图像。",
      "from": "bridge"
    },
    {
      "key": "omni",
      "name": "原生全模态",
      "aka": ["全模态", "Omni", "Omni-modal", "Omni Model", "全模态大模型", "端到端多模态", "实时音视频交互", "Native Multimodal", "原生多模态", "全双工"],
      "blurb": "把文字、图像、音频放进同一个模型端到端处理，支持实时语音视频交互。",
      "from": "bridge",
      "via": "gpt-4v"
    }
  ],
