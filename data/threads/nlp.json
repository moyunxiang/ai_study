{
  "threads": [
    {
      "key": "lm",
      "name": "语言模型",
      "blurb": "怎样给一句话估概率、预测下一个词：从数词频到用神经网络建模。",
      "from": null
    },
    {
      "key": "smt",
      "name": "规则与统计翻译",
      "blurb": "让计算机把一种语言译成另一种：先靠手写规则，后靠从双语语料里估概率。",
      "from": null
    },
    {
      "key": "nmt",
      "name": "神经机器翻译与生成",
      "blurb": "用一个编码器-解码器网络端到端地翻译和生成文本，并用注意力对齐原文。",
      "from": "smt",
      "via": "phrase-smt"
    },
    {
      "key": "dialog-qa",
      "name": "对话与问答",
      "blurb": "让机器用自然语言和人聊天、回答问题，乃至读懂一段文章再作答。",
      "from": null
    },
    {
      "key": "wordvec",
      "name": "词向量",
      "blurb": "用一个词常和哪些词一起出现来刻画词义，把每个词变成一个向量。",
      "from": null
    },
    {
      "key": "sentence",
      "name": "句子表示与分类",
      "blurb": "把整句话压成一个向量，用来判断情感、类别或两句话是否相近。",
      "from": "wordvec",
      "via": "collobert-weston"
    },
    {
      "key": "parsing",
      "name": "句法分析",
      "blurb": "自动找出句子的语法结构：哪些词组成短语，哪个词修饰哪个词。",
      "from": null
    },
    {
      "key": "ir",
      "name": "检索与文本挖掘",
      "blurb": "从海量文档里找出和查询最相关的那些，并归纳文本的主题与类别。",
      "from": null
    },
    {
      "key": "semantics",
      "name": "语义与篇章",
      "blurb": "弄清句子说的是谁对谁做了什么、代词指谁、多义词取哪个意思。",
      "from": null
    },
    {
      "key": "tagging",
      "name": "序列标注",
      "blurb": "给句子里每个词或字贴上标签，如词性、人名地名、分词边界。",
      "from": null
    },
    {
      "key": "ie-kb",
      "name": "信息抽取与知识库",
      "blurb": "从文本中抽出实体和关系，整理成机器可查询的大规模知识库。",
      "from": null
    },
    {
      "key": "subword",
      "name": "子词切分",
      "blurb": "把词切成更小的片段，让固定大小的词表也能覆盖生僻词和新词。",
      "from": null
    }
  ],
