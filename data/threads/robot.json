{
  "threads": [
    {
      "key": "classic",
      "name": "经典控制与规划",
      "blurb": "不靠学习，用数学模型算出怎样控制、规划路径、知道自己在哪。",
      "aka": ["经典机器人学", "控制理论", "运动规划", "路径规划", "SLAM", "Classical Robotics", "Motion Planning", "Optimal Control", "定位与建图"],
      "from": null
    },
    {
      "key": "hardware",
      "name": "机器人本体与产业",
      "blurb": "造出能干活的机器人身体，从工厂机械臂一路走到量产人形机器人。",
      "aka": ["人形机器人", "Humanoid", "机器人硬件", "具身智能产业", "Robot Hardware", "工业机器人", "机器人公司"],
      "from": null
    },
    {
      "key": "legged",
      "name": "腿足与全身控制",
      "blurb": "让四足、双足和人形机器人走稳、跑跳，并像人一样做全身动作。",
      "aka": ["足式机器人", "四足", "双足", "人形机器人控制", "全身控制", "WBC", "Whole-Body Control", "Legged Locomotion", "Motion Tracking", "动作跟踪", "Humanoid Control", "运控"],
      "from": null
    },
    {
      "key": "driving",
      "name": "自动驾驶",
      "blurb": "让汽车自己看路、做决策，从模块化系统走向端到端和驾驶大模型。",
      "aka": ["自动驾驶", "无人驾驶", "Autonomous Driving", "Self-Driving", "AD", "端到端自动驾驶", "E2E AD", "Robotaxi", "智驾", "BEV", "驾驶VLA", "辅助驾驶"],
      "from": null
    },
    {
      "key": "latent-wm",
      "name": "想象训练世界模型",
      "blurb": "先学一个能预测环境变化的模型，再在它的“梦”里训练策略或做规划。",
      "aka": ["世界模型", "World Model", "潜空间世界模型", "Latent World Model", "Dreamer", "模型强化学习", "MBRL", "想象训练", "Learning in Imagination"],
      "from": null
    },
    {
      "key": "jepa",
      "name": "JEPA预测表示",
      "blurb": "不去预测每个像素，只在抽象特征空间里预测未来，用来理解和规划。",
      "aka": ["JEPA", "联合嵌入预测架构", "Joint-Embedding Predictive Architecture", "V-JEPA", "LeCun世界模型", "表示空间预测"],
      "from": "latent-wm",
      "via": "world-models"
    },
    {
      "key": "video-sim",
      "name": "视频世界模拟器",
      "blurb": "用视频生成模型造出可交互的虚拟世界，替代真实环境来试驾、训练和评测。",
      "aka": ["视频世界模型", "交互式世界模型", "Interactive World Model", "生成式仿真", "Generative Simulator", "可玩世界模型", "神经游戏引擎", "World Simulator", "世界模拟器", "驾驶世界模型"],
      "from": "latent-wm",
      "via": "world-models"
    },
    {
      "key": "manip",
      "name": "操作技能学习",
      "blurb": "让机械臂从示范或试错中学会抓取、摆放和双手精细操作。",
      "aka": ["机器人操作", "机械臂操作", "Robot Manipulation", "灵巧操作", "Dexterous Manipulation", "模仿学习", "行为克隆", "Behavior Cloning", "扩散策略", "Diffusion Policy", "抓取", "Grasping"],
      "from": null
    },
    {
      "key": "sim-data",
      "name": "仿真、数据与评测",
      "blurb": "机器人数据又少又贵：靠仿真迁移、遥操作采集、共享数据集和统一评测来补。",
      "aka": ["仿真", "机器人仿真", "Simulation", "Sim2Real", "Sim-to-Real", "遥操作", "Teleoperation", "机器人数据集", "Robot Dataset", "数据采集", "机器人评测", "Benchmark", "具身数据"],
      "from": "manip"
    },
    {
      "key": "video-action",
      "name": "从视频预测到WAM",
      "blurb": "先想象动作后的画面再决定怎么做，最终让视频模型直接输出动作。",
      "aka": ["WAM", "世界动作模型", "World Action Model", "视频动作模型", "Video-Action Model", "视频预测策略", "Video Policy", "视频生成即策略", "世界-动作模型"],
      "from": "manip",
      "via": "levine-grasping"
    },
    {
      "key": "language",
      "name": "语言规划与具身推理",
      "blurb": "让机器人听懂人话，借大模型的常识拆解任务、写代码、推理下一步。",
      "aka": ["具身推理", "Embodied Reasoning", "LLM规划", "语言条件操作", "视觉语言导航", "VLN", "具身智能体", "Embodied Agent", "任务规划", "具身思维链"],
      "from": null
    },
    {
      "key": "vla",
      "name": "VLA基础模型",
      "blurb": "用一个看图、懂语言、直接出动作的大模型，控制各种机器人做各种任务。",
      "aka": ["VLA", "视觉-语言-动作模型", "Vision-Language-Action", "Vision-Language-Action Model", "机器人基础模型", "Robot Foundation Model", "具身大模型", "通用机器人策略", "Generalist Robot Policy", "GFM", "大行为模型", "LBM"],
      "from": "language",
      "via": "saycan"
    }
  ],
