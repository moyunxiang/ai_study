{
  "threads": [
    {
      "key": "shared-task",
      "name": "共同任务与标注语料",
      "blurb": "大家用同一份精标语料、同一套评分同台比方法，统计NLP由此起步。",
      "from": null
    },
    {
      "key": "speech",
      "name": "语音语料与评测",
      "blurb": "录多少小时、什么口音的语音来训练和考核语音识别与合成。",
      "from": "shared-task",
      "via": "darpa-ctf"
    },
    {
      "key": "nlu",
      "name": "阅读理解与语言理解",
      "blurb": "出题考机器能否读懂文本：问答、推理蕴含、常识，再汇成综合榜单。",
      "from": "shared-task",
      "via": "rte"
    },
    {
      "key": "llm-exam",
      "name": "大模型知识与推理考卷",
      "blurb": "旧榜被刷满后，用学科、数学、专家难题和抽象谜题继续拉开大模型差距。",
      "from": "nlu",
      "via": "glue"
    },
    {
      "key": "code",
      "name": "代码与软件工程",
      "blurb": "让模型写的程序跑单元测试判对错，从写函数一路考到修真实仓库的bug。",
      "from": "llm-exam"
    },
    {
      "key": "scoring",
      "name": "开放式输出的评分",
      "blurb": "译文、摘要、图像和对话没有唯一答案，怎样自动或靠人投票给它们打分。",
      "from": null
    },
    {
      "key": "vision",
      "name": "视觉数据集",
      "blurb": "给图像、视频和三维场景配上标准答案，让识别、检测、分割能公平比较。",
      "from": null
    },
    {
      "key": "multimodal",
      "name": "视觉问答与多模态基准",
      "blurb": "看图回答问题、读图表文档、做跨学科推理，考模型能否把看和想连起来。",
      "from": "vision",
      "via": "coco"
    },
    {
      "key": "web-corpus",
      "name": "网络规模训练语料",
      "blurb": "从网上抓海量文本和图文，清洗去重成可用于预训练的大语料。",
      "from": null
    },
    {
      "key": "data-supply",
      "name": "数据的生产与治理",
      "blurb": "训练数据由谁来标、花多少钱、是否合法合规，又会不会被用完。",
      "from": null
    },
    {
      "key": "trust",
      "name": "基准的可信度",
      "blurb": "高分是否真本事？揭示数据偏差、捷径、标注错误与测试集泄漏，再修补考卷。",
      "from": null
    },
    {
      "key": "agent",
      "name": "智能体与真实工作",
      "blurb": "让模型自己操作网页、电脑和工具完成整件任务，并量出它能独立干多久。",
      "from": null
    }
  ],
