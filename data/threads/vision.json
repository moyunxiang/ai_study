{
  "threads": [
    {"key": "backbone", "name": "卷积骨干网络", "blurb": "怎样设计并训练一个通用的卷积网络，把图像特征提取做深、做准、做快。", "from": null, "aka": ["CNN", "卷积神经网络", "ConvNet", "Convolutional Neural Network", "视觉骨干", "backbone", "图像分类", "image classification", "ImageNet分类", "轻量网络", "数据增强"]},
    {"key": "face-pose", "name": "人脸与人体姿态", "blurb": "专门认人：认出是谁的脸，找出人体关节在哪、身体是什么形状。", "from": "backbone", "via": "alexnet", "aka": ["人脸识别", "face recognition", "人体姿态估计", "human pose estimation", "关键点检测", "keypoint detection", "人体网格重建", "human mesh recovery", "HMR", "人脸检测"]},
    {"key": "detection", "name": "目标检测", "blurb": "不只说图里有什么，还要用框标出每个物体（包括文字）在哪。", "from": "backbone", "via": "alexnet", "aka": ["object detection", "物体检测", "检测器", "YOLO", "DETR", "两阶段检测", "单阶段检测", "实时检测", "real-time detection", "开放词表检测", "open-vocabulary detection", "OVD", "OCR", "文字识别", "文字检测", "text detection", "scene text"]},
    {"key": "self-supervised", "name": "视觉自监督", "blurb": "不靠人工标注，从海量无标签图像里学出通用的视觉特征。", "from": "backbone", "via": "alexnet", "aka": ["SSL", "self-supervised learning", "自监督学习", "视觉自监督", "visual SSL", "对比学习", "contrastive learning", "掩码图像建模", "MIM", "masked image modeling", "无监督表征学习", "representation learning"]},
    {"key": "depth", "name": "单目深度估计", "blurb": "只看一张照片，估计画面里每个点离相机有多远。", "from": "backbone", "via": "alexnet", "aka": ["monocular depth estimation", "MDE", "深度估计", "depth estimation", "度量深度", "metric depth", "相对深度", "视频深度", "video depth", "单目几何", "monocular geometry"]},
    {"key": "segmentation", "name": "图像分割", "blurb": "给每个像素分类，把物体的轮廓精确抠出来，直到任意提示都能分割。", "from": "backbone", "via": "vgg", "aka": ["image segmentation", "语义分割", "semantic segmentation", "实例分割", "instance segmentation", "全景分割", "panoptic segmentation", "可提示分割", "promptable segmentation", "SAM", "分割一切", "Segment Anything", "抠图"]},
    {"key": "vit", "name": "ViT与新架构", "blurb": "把图像切成小块当作词，用Transformer代替卷积做视觉骨干。", "from": "backbone", "via": "transformer", "aka": ["Vision Transformer", "视觉Transformer", "ViT", "视觉骨干网络", "vision backbone", "视觉编码器", "vision encoder", "Vision Mamba", "MLP-Mixer"]},
    {"key": "handcrafted", "name": "手工特征", "blurb": "深度学习之前，靠人设计的边缘、角点、梯度直方图等特征来识别图像。", "from": null, "aka": ["传统视觉", "传统计算机视觉", "classical computer vision", "特征工程", "feature engineering", "局部特征", "SIFT", "HOG", "边缘检测", "角点检测"]},
    {"key": "geometry", "name": "多视图几何与重建", "blurb": "从多张照片恢复相机位置和场景三维结构，从几何流水线走向前馈网络。", "from": "handcrafted", "aka": ["SfM", "Structure from Motion", "运动恢复结构", "MVS", "多视图立体", "multi-view stereo", "SLAM", "视觉SLAM", "三维重建", "3D reconstruction", "前馈三维重建", "feed-forward 3D reconstruction", "特征匹配", "feature matching", "位姿估计", "pointmap", "DUSt3R系列"]},
    {"key": "neural-3d", "name": "三维表示与神经渲染", "blurb": "用神经网络表示三维形状和场景，并从新视角逼真地渲染出来。", "from": "geometry", "aka": ["神经渲染", "neural rendering", "新视角合成", "novel view synthesis", "NVS", "NeRF", "神经辐射场", "3DGS", "高斯泼溅", "Gaussian Splatting", "高斯溅射", "3D高斯", "点云", "point cloud", "隐式表示", "implicit neural representation", "SDF"]},
    {"key": "motion", "name": "视频与运动", "blurb": "画面动起来之后：估计像素怎样移动、跟住目标、识别视频里的动作。", "from": "handcrafted", "aka": ["光流", "optical flow", "目标跟踪", "object tracking", "多目标跟踪", "MOT", "multi-object tracking", "点跟踪", "point tracking", "TAP", "Tracking Any Point", "视频识别", "动作识别", "action recognition", "video recognition"]},
    {"key": "low-level", "name": "图像复原", "blurb": "把有噪声、模糊或分辨率低的图像恢复成清晰的高质量图像。", "from": "handcrafted", "aka": ["底层视觉", "low-level vision", "图像复原", "image restoration", "去噪", "denoising", "超分辨率", "super-resolution", "SR", "去模糊", "deblurring", "图像增强"]}
