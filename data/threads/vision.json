{
  "threads": [
    {"key": "backbone", "name": "卷积骨干网络", "blurb": "怎样设计并训练一个通用的卷积网络，把图像特征提取做深、做准、做快。", "from": null},
    {"key": "face-pose", "name": "人脸与人体姿态", "blurb": "专门认人：认出是谁的脸，找出人体关节在哪、身体是什么形状。", "from": "backbone", "via": "alexnet"},
    {"key": "detection", "name": "目标检测", "blurb": "不只说图里有什么，还要用框标出每个物体（包括文字）在哪。", "from": "backbone", "via": "alexnet"},
    {"key": "self-supervised", "name": "视觉自监督", "blurb": "不靠人工标注，从海量无标签图像里学出通用的视觉特征。", "from": "backbone", "via": "alexnet"},
    {"key": "depth", "name": "单目深度估计", "blurb": "只看一张照片，估计画面里每个点离相机有多远。", "from": "backbone", "via": "alexnet"},
    {"key": "segmentation", "name": "图像分割", "blurb": "给每个像素分类，把物体的轮廓精确抠出来，直到任意提示都能分割。", "from": "backbone", "via": "vgg"},
    {"key": "vit", "name": "ViT与新架构", "blurb": "把图像切成小块当作词，用Transformer代替卷积做视觉骨干。", "from": "backbone", "via": "transformer"},
    {"key": "handcrafted", "name": "手工特征", "blurb": "深度学习之前，靠人设计的边缘、角点、梯度直方图等特征来识别图像。", "from": null},
    {"key": "geometry", "name": "多视图几何与重建", "blurb": "从多张照片恢复相机位置和场景三维结构，从几何流水线走向前馈网络。", "from": "handcrafted"},
    {"key": "neural-3d", "name": "三维表示与神经渲染", "blurb": "用神经网络表示三维形状和场景，并从新视角逼真地渲染出来。", "from": "geometry"},
    {"key": "motion", "name": "视频与运动", "blurb": "画面动起来之后：估计像素怎样移动、跟住目标、识别视频里的动作。", "from": "handcrafted"},
    {"key": "low-level", "name": "图像复原", "blurb": "把有噪声、模糊或分辨率低的图像恢复成清晰的高质量图像。", "from": "handcrafted"}
  ],
