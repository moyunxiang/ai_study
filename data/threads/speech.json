{
  "threads": [
    {
      "key": "early",
      "name": "早期识别与声学特征",
      "blurb": "在统计模型之前，靠模板比对、知识规则和声学特征让机器听懂少量词。",
      "from": null
    },
    {
      "key": "tts",
      "name": "语音合成",
      "blurb": "怎样把文字变成自然流畅、像真人说出来的语音。",
      "from": "early",
      "via": "lpc"
    },
    {
      "key": "waveform",
      "name": "神经声码器与编解码",
      "blurb": "怎样用神经网络直接生成高保真波形，并把音频压成可还原的离散token。",
      "from": "tts",
      "via": "pixelrnn"
    },
    {
      "key": "music",
      "name": "音乐与音效生成",
      "blurb": "让机器按文字描述或画面生成乐曲、歌曲和各种声音效果。",
      "from": "waveform",
      "via": "wavenet"
    },
    {
      "key": "zeroshot",
      "name": "声音克隆与零样本合成",
      "blurb": "只听几秒录音，就能用任何人的声音说出任意文字。",
      "from": "tts",
      "via": "tacotron-2"
    },
    {
      "key": "hmm",
      "name": "HMM统计识别",
      "blurb": "用隐马尔可夫模型和语言模型，把语音识别变成可训练的概率计算。",
      "from": null
    },
    {
      "key": "hybrid",
      "name": "神经网络声学模型",
      "blurb": "用神经网络替换高斯混合模型，判断每一帧声音对应哪个音素。",
      "from": "hmm",
      "via": "backprop"
    },
    {
      "key": "e2e",
      "name": "端到端识别",
      "blurb": "不再拼装声学、发音和语言模型，一个网络直接把声音转成文字。",
      "from": "hybrid",
      "via": "lstm"
    },
    {
      "key": "translation",
      "name": "语音翻译",
      "blurb": "听一种语言的语音，直接说出或写出另一种语言。",
      "from": "e2e"
    },
    {
      "key": "ssl",
      "name": "语音自监督与多语言",
      "blurb": "用海量无标注音频预训练，让少量标注甚至无标注语言也能识别。",
      "from": "e2e",
      "via": "cpc"
    },
    {
      "key": "analysis",
      "name": "说话人与声音分析",
      "blurb": "不管说了什么字，而是分辨谁在说、分开混在一起的声音、认出是什么声音。",
      "from": "hmm",
      "via": "mllr"
    },
    {
      "key": "dialogue",
      "name": "语音助手与对话模型",
      "blurb": "让机器用声音和人自然对话：从语音助手到能边听边说的语音大模型。",
      "from": null
    }
  ],
