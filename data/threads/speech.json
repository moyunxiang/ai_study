{
  "threads": [
    {
      "key": "early",
      "name": "早期识别与声学特征",
      "blurb": "在统计模型之前，靠模板比对、知识规则和声学特征让机器听懂少量词。",
      "aka": ["早期语音识别", "孤立词识别", "模板匹配", "声学特征", "MFCC", "LPC", "DTW", "语音识别史"],
      "from": null
    },
    {
      "key": "tts",
      "name": "语音合成",
      "blurb": "怎样把文字变成自然流畅、像真人说出来的语音。",
      "aka": ["TTS", "Text-to-Speech", "文本转语音", "文字转语音", "参数合成", "拼接合成", "端到端TTS", "neural TTS", "神经语音合成"],
      "from": "early",
      "via": "lpc"
    },
    {
      "key": "waveform",
      "name": "神经声码器与编解码",
      "blurb": "怎样用神经网络直接生成高保真波形，并把音频压成可还原的离散token。",
      "aka": ["Vocoder", "声码器", "神经声码器", "neural vocoder", "音频编解码", "神经音频编解码", "neural audio codec", "audio codec", "codec", "音频token", "RVQ", "残差向量量化"],
      "from": "tts",
      "via": "pixelrnn"
    },
    {
      "key": "music",
      "name": "音乐与音效生成",
      "blurb": "让机器按文字描述或画面生成乐曲、歌曲和各种声音效果。",
      "aka": ["AI音乐", "AI作曲", "音乐生成", "music generation", "text-to-music", "文生音乐", "TTM", "音效生成", "text-to-audio", "TTA", "文生音频", "歌曲生成"],
      "from": "waveform",
      "via": "wavenet"
    },
    {
      "key": "zeroshot",
      "name": "声音克隆与零样本合成",
      "blurb": "只听几秒录音，就能用任何人的声音说出任意文字。",
      "aka": ["零样本TTS", "zero-shot TTS", "语音克隆", "声音克隆", "voice cloning", "音色克隆", "AI配音", "codec language model", "大模型TTS", "LLM TTS", "语音转换", "voice conversion"],
      "from": "tts",
      "via": "tacotron-2"
    },
    {
      "key": "hmm",
      "name": "HMM统计识别",
      "blurb": "用隐马尔可夫模型和语言模型，把语音识别变成可训练的概率计算。",
      "aka": ["HMM", "隐马尔可夫模型", "GMM-HMM", "统计语音识别", "大词汇量连续语音识别", "LVCSR", "WFST解码"],
      "from": null
    },
    {
      "key": "hybrid",
      "name": "神经网络声学模型",
      "blurb": "用神经网络替换高斯混合模型，判断每一帧声音对应哪个音素。",
      "aka": ["DNN-HMM", "混合模型", "hybrid ASR", "深度学习声学模型", "acoustic model", "声学模型"],
      "from": "hmm",
      "via": "backprop"
    },
    {
      "key": "e2e",
      "name": "端到端识别",
      "blurb": "不再拼装声学、发音和语言模型，一个网络直接把声音转成文字。",
      "aka": ["ASR", "自动语音识别", "语音识别", "speech recognition", "STT", "speech-to-text", "语音转文字", "端到端ASR", "E2E ASR", "CTC", "RNN-T", "注意力编码器-解码器", "AED", "流式识别", "streaming ASR"],
      "from": "hybrid",
      "via": "lstm"
    },
    {
      "key": "translation",
      "name": "语音翻译",
      "blurb": "听一种语言的语音，直接说出或写出另一种语言。",
      "aka": ["语音翻译", "speech translation", "ST", "S2ST", "speech-to-speech translation", "语音到语音翻译", "同声传译", "同传", "simultaneous translation", "AI同传"],
      "from": "e2e"
    },
    {
      "key": "ssl",
      "name": "语音自监督与多语言",
      "blurb": "用海量无标注音频预训练，让少量标注甚至无标注语言也能识别。",
      "aka": ["语音自监督", "self-supervised speech", "SSL", "语音预训练", "speech representation learning", "wav2vec", "多语言识别", "multilingual ASR", "低资源语音识别", "千语言"],
      "from": "e2e",
      "via": "cpc"
    },
    {
      "key": "analysis",
      "name": "说话人与声音分析",
      "blurb": "不管说了什么字，而是分辨谁在说、分开混在一起的声音、认出是什么声音。",
      "aka": ["说话人识别", "speaker recognition", "声纹识别", "声纹", "说话人验证", "speaker verification", "说话人日志", "diarization", "语音分离", "speech separation", "语音增强", "降噪", "音频分类", "audio classification", "声音事件检测", "音频表示"],
      "from": "hmm",
      "via": "mllr"
    },
    {
      "key": "dialogue",
      "name": "语音助手与对话模型",
      "blurb": "让机器用声音和人自然对话：从语音助手到能边听边说的语音大模型。",
      "aka": ["语音助手", "voice assistant", "语音对话", "spoken dialogue", "语音大模型", "Speech LLM", "SpeechLM", "端到端语音对话", "全双工", "full-duplex", "语音交互", "音频大模型", "LALM", "Audio LLM", "实时语音"],
      "from": null
    }
  ],
