{
  "threads": [
    {
      "key": "board-games",
      "name": "棋类与树搜索",
      "blurb": "完全信息的棋类里，怎样靠搜索加学到的评估战胜人类顶尖棋手。",
      "aka": ["棋类AI", "博弈树搜索", "围棋AI", "国际象棋AI", "Game Tree Search", "Board Game AI", "MCTS", "蒙特卡洛树搜索", "AlphaGo系列", "alpha-beta"],
      "from": null
    },
    {
      "key": "imperfect",
      "name": "不完全信息博弈",
      "blurb": "看不到对手底牌、需要虚张声势时，怎样逼近均衡策略。",
      "aka": ["不完美信息博弈", "扑克AI", "德州扑克AI", "Imperfect-Information Games", "CFR", "反事实遗憾最小化", "博弈论", "均衡求解", "Game Theory"],
      "from": "board-games",
      "via": "game-theory-1944"
    },
    {
      "key": "value",
      "name": "价值函数与时序差分",
      "blurb": "怎样从延迟的奖励里估计每一步的好坏，并据此逐步改进决策。",
      "aka": ["TD学习", "时序差分", "值函数", "价值学习", "Temporal Difference", "TD Learning", "Value Function", "Q学习", "Q-learning", "表格RL", "动态规划", "Bellman方程"],
      "from": null
    },
    {
      "key": "deep-value",
      "name": "深度值函数",
      "blurb": "用深度网络近似价值，并让它训练得稳定、省样本、能扩展。",
      "aka": ["深度Q网络", "DQN系列", "Deep Q-Learning", "Value-Based Deep RL", "值方法", "深度值方法", "分布式RL", "Distributional RL", "Atari"],
      "from": "value",
      "via": "nfq"
    },
    {
      "key": "model-based",
      "name": "模型与规划",
      "blurb": "先学会环境怎样变化，再在学到的模型里规划，以少量试错学会决策。",
      "aka": ["基于模型的RL", "模型RL", "MBRL", "Model-Based RL", "规划", "Planning", "学到的模型", "MuZero系列", "Dyna"],
      "from": "value",
      "via": "td-learning"
    },
    {
      "key": "multi-agent",
      "name": "多智能体与电子游戏",
      "blurb": "多个智能体一起学习、协作对抗，并攻克实时大型游戏与开放世界。",
      "aka": ["多智能体强化学习", "MARL", "Multi-Agent RL", "Multi-Agent Reinforcement Learning", "多智能体RL", "群体智能", "集群强化学习", "swarm", "swarm RL", "游戏AI", "电竞AI", "Game AI", "自博弈", "self-play"],
      "from": "value",
      "via": "q-learning"
    },
    {
      "key": "abstraction",
      "name": "分层、表示与元学习",
      "blurb": "把长任务拆成子目标与技能，学好用的表示，甚至学会怎样学习。",
      "aka": ["分层强化学习", "层次强化学习", "HRL", "Hierarchical RL", "元强化学习", "Meta-RL", "Meta Reinforcement Learning", "表示学习", "技能发现", "Options"],
      "from": "value",
      "via": "q-learning"
    },
    {
      "key": "reward",
      "name": "奖励与模仿",
      "blurb": "奖励难以手写时，怎样从示范或人类偏好里学到该做什么。",
      "aka": ["模仿学习", "Imitation Learning", "逆强化学习", "IRL", "Inverse RL", "行为克隆", "Behavior Cloning", "BC", "奖励学习", "奖励塑形", "偏好学习", "Learning from Demonstrations"],
      "from": "value",
      "via": "q-learning"
    },
    {
      "key": "offline",
      "name": "离线RL与序列建模",
      "blurb": "不再与环境交互，只用一批旧数据学策略，或把决策改写成序列预测。",
      "aka": ["离线强化学习", "Offline RL", "批量强化学习", "Batch RL", "数据驱动RL", "Data-Driven RL", "序列建模RL", "RL via Sequence Modeling", "Decision Transformer系列"],
      "from": "value",
      "via": "fitted-q"
    },
    {
      "key": "explore",
      "name": "探索与好奇心",
      "blurb": "不知道奖励在哪时，怎样在尝试新动作和利用已知之间取舍。",
      "aka": ["探索", "Exploration", "内在动机", "Intrinsic Motivation", "好奇心驱动", "Curiosity-Driven", "多臂老虎机", "Bandit", "MAB", "探索与利用", "无监督RL", "Unsupervised RL"],
      "from": null
    },
    {
      "key": "policy",
      "name": "策略梯度与演员评论家",
      "blurb": "直接沿着回报的梯度调整策略，并让更新稳定、可并行、适合连续动作。",
      "aka": ["策略梯度", "Policy Gradient", "PG", "Actor-Critic", "AC", "演员-评论家", "策略优化", "Policy Optimization", "PPO系列", "信赖域", "On-Policy RL"],
      "from": null
    },
    {
      "key": "benchmarks",
      "name": "环境与评测",
      "blurb": "提供统一的试验环境、可靠的基线和统计方法，让算法比较可信可复现。",
      "aka": ["RL基准", "RL环境", "RL Benchmark", "Gym", "强化学习评测", "复现性", "Reproducibility", "RL库"],
      "from": null
    }
  ],
