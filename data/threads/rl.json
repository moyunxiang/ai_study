{
  "threads": [
    {
      "key": "board-games",
      "name": "棋类与树搜索",
      "blurb": "完全信息的棋类里，怎样靠搜索加学到的评估战胜人类顶尖棋手。",
      "from": null
    },
    {
      "key": "imperfect",
      "name": "不完全信息博弈",
      "blurb": "看不到对手底牌、需要虚张声势时，怎样逼近均衡策略。",
      "from": "board-games",
      "via": "game-theory-1944"
    },
    {
      "key": "value",
      "name": "价值函数与时序差分",
      "blurb": "怎样从延迟的奖励里估计每一步的好坏，并据此逐步改进决策。",
      "from": null
    },
    {
      "key": "deep-value",
      "name": "深度值函数",
      "blurb": "用深度网络近似价值，并让它训练得稳定、省样本、能扩展。",
      "from": "value",
      "via": "nfq"
    },
    {
      "key": "model-based",
      "name": "模型与规划",
      "blurb": "先学会环境怎样变化，再在学到的模型里规划，以少量试错学会决策。",
      "from": "value",
      "via": "td-learning"
    },
    {
      "key": "multi-agent",
      "name": "多智能体与电子游戏",
      "blurb": "多个智能体一起学习、协作对抗，并攻克实时大型游戏与开放世界。",
      "from": "value",
      "via": "q-learning"
    },
    {
      "key": "abstraction",
      "name": "分层、表示与元学习",
      "blurb": "把长任务拆成子目标与技能，学好用的表示，甚至学会怎样学习。",
      "from": "value",
      "via": "q-learning"
    },
    {
      "key": "reward",
      "name": "奖励与模仿",
      "blurb": "奖励难以手写时，怎样从示范或人类偏好里学到该做什么。",
      "from": "value",
      "via": "q-learning"
    },
    {
      "key": "offline",
      "name": "离线RL与序列建模",
      "blurb": "不再与环境交互，只用一批旧数据学策略，或把决策改写成序列预测。",
      "from": "value",
      "via": "fitted-q"
    },
    {
      "key": "explore",
      "name": "探索与好奇心",
      "blurb": "不知道奖励在哪时，怎样在尝试新动作和利用已知之间取舍。",
      "from": null
    },
    {
      "key": "policy",
      "name": "策略梯度与演员评论家",
      "blurb": "直接沿着回报的梯度调整策略，并让更新稳定、可并行、适合连续动作。",
      "from": null
    },
    {
      "key": "benchmarks",
      "name": "环境与评测",
      "blurb": "提供统一的试验环境、可靠的基线和统计方法，让算法比较可信可复现。",
      "from": null
    }
  ],
