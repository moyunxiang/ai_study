{
  "threads": [
    {
      "key": "arch",
      "name": "处理器体系结构",
      "blurb": "通用处理器怎样一步步变快，又为何在单核提速走到尽头后转向并行和专用。",
      "aka": ["计算机体系结构", "Computer Architecture", "CPU架构", "处理器架构", "指令集", "ISA", "微架构"],
      "from": null
    },
    {
      "key": "memory",
      "name": "内存与带宽",
      "blurb": "计算越来越快，数据从内存搬到芯片却跟不上，这道内存墙怎样一次次被推开。",
      "aka": ["内存墙", "Memory Wall", "显存", "HBM", "高带宽内存", "High Bandwidth Memory", "DRAM", "存储", "内存带宽", "Memory Bandwidth", "存储芯片"],
      "from": "arch"
    },
    {
      "key": "cluster",
      "name": "互连与超级集群",
      "blurb": "怎样把成千上万颗芯片用网络连成一台机器，从超算一路扩到吉瓦级AI集群。",
      "aka": ["互连", "Interconnect", "网络互连", "光互连", "Scale-up", "Scale-out", "纵向扩展", "横向扩展", "超节点", "SuperPod", "AI集群", "GPU集群", "超算", "Supercomputer", "RDMA", "NVLink", "InfiniBand", "以太网"],
      "from": "arch",
      "via": "amdahl-law"
    },
    {
      "key": "accel",
      "name": "AI加速器",
      "blurb": "不再用通用芯片，而是专门为神经网络设计电路，研究界和创业公司的各种尝试。",
      "aka": ["AI芯片", "AI Accelerator", "AI加速芯片", "ASIC", "专用芯片", "NPU", "推理芯片", "Inference Chip", "AI芯片创业公司", "Domain-Specific Accelerator", "DSA", "领域专用架构"],
      "from": "arch",
      "via": "systolic-array"
    },
    {
      "key": "cloud-asic",
      "name": "TPU与云端自研芯片",
      "blurb": "谷歌、亚马逊、微软等云厂商为自家数据中心定制AI芯片，摆脱对GPU的依赖。",
      "aka": ["TPU", "Tensor Processing Unit", "张量处理器", "自研芯片", "Custom Silicon", "Hyperscaler ASIC", "云厂商芯片", "定制ASIC", "XPU", "Trainium", "Maia"],
      "from": "accel",
      "via": "diannao"
    },
    {
      "key": "process",
      "name": "制程与封装",
      "blurb": "晶体管怎样越做越小、越堆越密，以及制程放缓后靠先进封装继续提升芯片能力。",
      "aka": ["制程", "工艺节点", "Process Node", "先进封装", "Advanced Packaging", "2.5D封装", "3D封装", "晶圆代工", "Foundry", "光刻", "Lithography", "半导体制造", "CoWoS", "Chiplet"],
      "from": null
    },
    {
      "key": "neuro",
      "name": "类脑与神经网络芯片",
      "blurb": "用模拟电路、脉冲神经元或光来直接实现神经网络，走一条不同于数字芯片的路。",
      "aka": ["类脑芯片", "神经形态计算", "Neuromorphic Computing", "Neuromorphic Chip", "脉冲神经网络芯片", "SNN芯片", "存内计算", "In-Memory Computing", "CIM", "Compute-in-Memory", "模拟计算", "Analog AI", "光计算", "Photonic Computing", "光子芯片", "非冯·诺依曼"],
      "from": null,
      "via": "perceptron"
    },
    {
      "key": "gpgpu",
      "name": "GPU通用计算",
      "blurb": "图形显卡怎样变成可编程的通用计算设备，并被发现最适合训练神经网络。",
      "aka": ["GPGPU", "General-Purpose GPU", "GPU编程", "CUDA", "显卡", "GPU计算"],
      "from": null
    },
    {
      "key": "dc-gpu",
      "name": "数据中心GPU",
      "blurb": "为训练大模型打造的数据中心GPU：更多矩阵算力、更低精度、更大显存。",
      "aka": ["数据中心GPU", "Datacenter GPU", "AI GPU", "英伟达GPU", "NVIDIA GPU", "训练卡", "算力卡", "GPU"],
      "from": "gpgpu",
      "via": "tesla-gpu"
    },
    {
      "key": "edge",
      "name": "个人与端侧算力",
      "blurb": "让个人电脑、手机、汽车和机器人也有足够算力在本地跑模型。",
      "aka": ["端侧AI", "Edge AI", "On-device AI", "边缘计算", "AI PC", "手机芯片", "消费级显卡", "本地大模型硬件", "Local LLM Hardware"],
      "from": "gpgpu",
      "via": "gtx-580"
    },
    {
      "key": "economy",
      "name": "算力需求与电力",
      "blurb": "训练所需算力增长得有多快，由此引发的芯片短缺、资本开支竞赛和电力瓶颈。",
      "aka": ["算力", "Compute", "算力需求", "Compute Scaling", "AI电力", "数据中心电力", "Datacenter Power", "能耗", "AI能耗", "资本开支", "Capex", "GPU短缺", "算力经济", "AI基础设施", "AI Infrastructure"],
      "from": null
    },
    {
      "key": "policy",
      "name": "出口管制与国产算力",
      "blurb": "芯片怎样变成地缘政治工具：美国的管制与补贴，中国的反制与国产替代。",
      "aka": ["出口管制", "Export Controls", "芯片禁令", "Chip Ban", "芯片战争", "Chip War", "国产替代", "国产算力", "国产芯片", "实体清单", "Entity List", "BIS", "芯片法案", "地缘政治"],
      "from": null
    }
  ],
