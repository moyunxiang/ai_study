{
  "threads": [
    {"key": "latent-var", "name": "隐变量与标准化流", "blurb": "用可算概率的隐变量模型或可逆变换来拟合数据分布，并把它训练好。", "from": null, "aka": ["VAE", "变分自编码器", "Normalizing Flow", "标准化流", "归一化流", "Flow-based Model", "隐变量模型", "Latent Variable Model", "ELBO"]},
    {"key": "gan", "name": "对抗生成网络", "blurb": "让生成器和判别器互相对抗，生成锐利逼真的图像，并把训练做稳、做大。", "from": null, "aka": ["GAN", "GANs", "生成对抗网络", "Generative Adversarial Network", "判别器"]},
    {"key": "translation", "name": "图像翻译与风格迁移", "blurb": "把一张图变成另一种样子：换画风、从草图或语义图生成照片。", "from": "gan", "aka": ["Image-to-Image Translation", "图像到图像翻译", "风格迁移", "Style Transfer", "图像转换"]},
    {"key": "autoregressive", "name": "自回归与视觉分词", "blurb": "把图像切成像素或离散token，像写句子一样逐个预测出来。", "from": null, "aka": ["自回归图像生成", "Autoregressive Image Generation", "AR图像生成", "视觉分词器", "Visual Tokenizer", "图像分词器", "Image Tokenizer", "VQ", "离散token", "Next-Token Prediction", "下一个token预测", "掩码图像生成", "Masked Image Generation", "Next-Scale Prediction"]},
    {"key": "native", "name": "原生多模态出图", "blurb": "让大语言模型自己直接画图和改图，理解与生成合在一个模型里。", "from": "autoregressive", "via": "gpt-4o", "aka": ["原生图像生成", "Native Image Generation", "统一多模态模型", "Unified Multimodal Model", "理解与生成统一", "Any-to-Any", "多模态大模型出图", "Unified Model", "对话式出图"]},
    {"key": "diffusion", "name": "扩散与流匹配", "blurb": "把生成拆成从噪声一步步去噪的过程，建立理论并把训练和引导做好。", "from": null, "aka": ["扩散模型", "Diffusion Model", "Diffusion Models", "Score-based Model", "分数模型", "流匹配", "Flow Matching", "整流流", "Rectified Flow", "Flow Models", "流模型", "SDE", "概率流ODE"]},
    {"key": "fast-sampling", "name": "少步采样与蒸馏", "blurb": "扩散模型要走上千步太慢，怎样压到几步甚至一步就出图。", "from": "diffusion", "via": "ddpm", "aka": ["一步生成", "One-step Generation", "少步生成", "Few-step Generation", "扩散蒸馏", "Diffusion Distillation", "步数蒸馏", "Step Distillation", "加速采样", "Fast Sampling", "一致性模型", "Consistency Model", "Turbo", "Lightning", "采样器", "ODE Solver"]},
    {"key": "latent-backbone", "name": "潜空间与骨架网络", "blurb": "在压缩后的潜空间里生成以省算力，并换成可扩展的Transformer骨架。", "from": "diffusion", "via": "ddpm", "aka": ["潜扩散", "Latent Diffusion", "Diffusion Transformer", "扩散Transformer", "VAE tokenizer", "表示对齐", "Representation Alignment", "像素空间扩散", "Pixel-space Diffusion", "Latent Space"]},
    {"key": "t2i", "name": "文生图系统", "blurb": "输入一句话就生成对应图片，并不断提升画质、理解力和文字渲染。", "from": "diffusion", "via": "adm", "aka": ["Text-to-Image", "T2I", "文本生成图像", "AI绘画", "AI画图", "图像生成模型", "Image Generation Model", "AIGC图像"]},
    {"key": "control", "name": "可控生成与编辑", "blurb": "让生成听用户的：指定构图和人物、修改已有图片、对齐人的偏好。", "from": "t2i", "aka": ["Controllable Generation", "图像编辑", "Image Editing", "个性化生成", "Personalization", "主体驱动生成", "Subject-driven Generation", "ID保持", "Identity Preservation", "扩散模型强化学习", "Diffusion RL", "RLHF for Diffusion", "偏好对齐", "Preference Alignment", "微调", "Inpainting", "图像修复"]},
    {"key": "video", "name": "视频生成", "blurb": "让画面动起来：生成时间连贯、动作合理的长视频，再配上同步声音。", "from": null, "aka": ["Video Generation", "文生视频", "Text-to-Video", "T2V", "图生视频", "Image-to-Video", "I2V", "AI视频", "视频扩散模型", "Video Diffusion", "长视频生成", "Long Video Generation", "自回归视频生成", "数字人", "音视频生成"]},
    {"key": "3d", "name": "三维生成", "blurb": "从文字或一张图片生成可从任意角度观看的三维物体和场景。", "from": null, "aka": ["3D生成", "3D Generation", "文生3D", "Text-to-3D", "图生3D", "Image-to-3D", "3D资产生成", "3D AIGC", "场景生成", "3D World Generation", "4D生成", "Mesh Generation"]}
  ],
