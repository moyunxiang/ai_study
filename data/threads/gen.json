{
  "threads": [
    {"key": "latent-var", "name": "隐变量与标准化流", "blurb": "用可算概率的隐变量模型或可逆变换来拟合数据分布，并把它训练好。", "from": null},
    {"key": "gan", "name": "对抗生成网络", "blurb": "让生成器和判别器互相对抗，生成锐利逼真的图像，并把训练做稳、做大。", "from": null},
    {"key": "translation", "name": "图像翻译与风格迁移", "blurb": "把一张图变成另一种样子：换画风、从草图或语义图生成照片。", "from": "gan"},
    {"key": "autoregressive", "name": "自回归与视觉分词", "blurb": "把图像切成像素或离散token，像写句子一样逐个预测出来。", "from": null},
    {"key": "native", "name": "原生多模态出图", "blurb": "让大语言模型自己直接画图和改图，理解与生成合在一个模型里。", "from": "autoregressive", "via": "gpt-4o"},
    {"key": "diffusion", "name": "扩散与流匹配", "blurb": "把生成拆成从噪声一步步去噪的过程，建立理论并把训练和引导做好。", "from": null},
    {"key": "fast-sampling", "name": "少步采样与蒸馏", "blurb": "扩散模型要走上千步太慢，怎样压到几步甚至一步就出图。", "from": "diffusion", "via": "ddpm"},
    {"key": "latent-backbone", "name": "潜空间与骨架网络", "blurb": "在压缩后的潜空间里生成以省算力，并换成可扩展的Transformer骨架。", "from": "diffusion", "via": "ddpm"},
    {"key": "t2i", "name": "文生图系统", "blurb": "输入一句话就生成对应图片，并不断提升画质、理解力和文字渲染。", "from": "diffusion", "via": "adm"},
    {"key": "control", "name": "可控生成与编辑", "blurb": "让生成听用户的：指定构图和人物、修改已有图片、对齐人的偏好。", "from": "t2i"},
    {"key": "video", "name": "视频生成", "blurb": "让画面动起来：生成时间连贯、动作合理的长视频，再配上同步声音。", "from": null},
    {"key": "3d", "name": "三维生成", "blurb": "从文字或一张图片生成可从任意角度观看的三维物体和场景。", "from": null}
  ],
