{
  "threads": [
    {
      "key": "risk-arguments",
      "name": "长期风险论证",
      "blurb": "AI变得比人强之后会不会失控、威胁人类，各方怎样论证与争辩。",
      "from": null
    },
    {
      "key": "alignment-problems",
      "name": "目标对齐与监督",
      "blurb": "怎样让AI追求我们真正想要的目标，不钻规则空子，并在它比人强时仍能监督。",
      "from": "risk-arguments"
    },
    {
      "key": "llm-alignment",
      "name": "行为准则与对齐训练",
      "blurb": "怎样把“有用、诚实、无害”写成准则，并真正训练进大语言模型。",
      "from": "alignment-problems",
      "via": "instructgpt"
    },
    {
      "key": "deception",
      "name": "欺骗与图谋",
      "blurb": "模型会不会表面听话、暗中另有目标，怎样测出来并在推理过程中盯住它。",
      "from": "alignment-problems",
      "via": "mesa-optimization"
    },
    {
      "key": "privacy",
      "name": "隐私与深度伪造",
      "blurb": "模型会不会泄露训练数据或被人窃取，伪造的内容能否被识别和追溯。",
      "from": null
    },
    {
      "key": "fairness",
      "name": "偏见与社会危害",
      "blurb": "模型会不会歧视某些人群、输出有害内容、伤害现实中的用户。",
      "from": null
    },
    {
      "key": "adversarial",
      "name": "对抗鲁棒性与投毒",
      "blurb": "输入或训练数据被恶意改动一点，模型就会出错；怎样攻击，又怎样防住。",
      "from": null
    },
    {
      "key": "jailbreak",
      "name": "越狱与提示注入",
      "blurb": "怎样诱骗大模型绕过安全限制或执行恶意指令，又怎样防住这些攻击。",
      "from": "adversarial"
    },
    {
      "key": "attribution",
      "name": "归因与探针",
      "blurb": "模型为什么给出这个预测：看它关注输入的哪部分、内部学到了什么概念。",
      "from": null
    },
    {
      "key": "mech-interp",
      "name": "机制可解释性",
      "blurb": "像逆向工程程序一样，拆出网络内部的特征和电路，看清它怎样一步步算出答案。",
      "from": "attribution",
      "via": "feature-visualization"
    },
    {
      "key": "governance",
      "name": "治理与监管",
      "blurb": "政府、国际峰会和公众怎样为AI定规则、划红线、争论该不该放慢。",
      "from": null
    },
    {
      "key": "frontier-evals",
      "name": "危险能力与扩展政策",
      "blurb": "前沿模型的网络攻击、生物等危险能力有多强，到哪一步必须加防护或停下。",
      "from": "governance"
    }
  ],
