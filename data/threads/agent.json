{
  "threads": [
    {
      "key": "retrieval",
      "name": "检索增强生成",
      "blurb": "模型记不住也记不准所有事实，怎样先查到相关资料再据此作答。",
      "from": null
    },
    {
      "key": "research",
      "name": "深度研究",
      "blurb": "让模型自己反复上网搜索、阅读和综合，写出有出处的研究报告。",
      "from": "retrieval",
      "via": "rag"
    },
    {
      "key": "cot",
      "name": "思维链提示",
      "blurb": "不改模型，只靠提示让它把中间步骤写出来，从而做对多步推理题。",
      "from": null
    },
    {
      "key": "search-verify",
      "name": "推理搜索与验证",
      "blurb": "让模型试探多条思路、逐步检查每一步对不对，并用自己的推理训练自己。",
      "from": "cot",
      "via": "cot"
    },
    {
      "key": "reasoner",
      "name": "推理模型",
      "blurb": "让模型先想再答，把思考时间变成可以加大的算力，换来更强的解题能力。",
      "from": "cot"
    },
    {
      "key": "rlvr",
      "name": "可验证奖励强化学习",
      "blurb": "用答案能自动判对错的题目做强化学习，让模型自己练出推理能力。",
      "from": "reasoner"
    },
    {
      "key": "context",
      "name": "提示、上下文与记忆",
      "blurb": "模型一次能看的内容有限，该把哪些提示、知识和过往记忆放进去。",
      "from": null
    },
    {
      "key": "tools",
      "name": "工具调用与开发接口",
      "blurb": "让模型按格式调用外部函数和API，并给开发者提供搭建智能体的接口。",
      "from": null
    },
    {
      "key": "protocols",
      "name": "智能体协议与生态",
      "blurb": "不同模型、工具和智能体之间怎样用统一的协议和格式接起来。",
      "from": "tools",
      "via": "function-calling"
    },
    {
      "key": "agents",
      "name": "智能体架构与多智能体",
      "blurb": "怎样让模型边想边做、循环行动、反思改进，并让多个智能体分工协作。",
      "from": null
    },
    {
      "key": "coding",
      "name": "编码智能体",
      "blurb": "从补全一行代码到独立读仓库、改代码、跑测试，连续完成整项软件任务。",
      "from": null
    },
    {
      "key": "computer-use",
      "name": "电脑与浏览器操作",
      "blurb": "让模型看懂屏幕截图，像人一样点击、输入，操作网页、手机和桌面软件。",
      "from": "agents"
    }
  ],
