{
  "threads": [
    {
      "key": "retrieval",
      "name": "检索增强生成",
      "blurb": "模型记不住也记不准所有事实，怎样先查到相关资料再据此作答。",
      "aka": ["RAG", "Retrieval-Augmented Generation", "检索增强", "向量检索", "稠密检索", "dense retrieval", "向量数据库", "vector database", "embedding检索", "重排序", "reranking", "GraphRAG", "知识库问答"],
      "from": null
    },
    {
      "key": "research",
      "name": "深度研究",
      "blurb": "让模型自己反复上网搜索、阅读和综合，写出有出处的研究报告。",
      "aka": ["Deep Research", "深度研究智能体", "研究智能体", "research agent", "deep search", "深度搜索", "AI研究助手", "报告生成"],
      "from": "retrieval",
      "via": "rag"
    },
    {
      "key": "cot",
      "name": "思维链提示",
      "blurb": "不改模型，只靠提示让它把中间步骤写出来，从而做对多步推理题。",
      "aka": ["CoT", "Chain-of-Thought", "思维链", "链式思考", "提示推理", "step-by-step", "逐步推理", "零样本思维链", "Let's think step by step"],
      "from": null
    },
    {
      "key": "search-verify",
      "name": "推理搜索与验证",
      "blurb": "让模型试探多条思路、逐步检查每一步对不对，并用自己的推理训练自己。",
      "aka": ["PRM", "过程奖励模型", "process reward model", "验证器", "verifier", "思维树", "ToT", "MCTS推理", "树搜索推理", "自我纠错", "self-correction", "自我改进", "self-refine", "奖励模型"],
      "from": "cot",
      "via": "cot"
    },
    {
      "key": "reasoner",
      "name": "推理模型",
      "blurb": "让模型先想再答，把思考时间变成可以加大的算力，换来更强的解题能力。",
      "aka": ["推理模型", "reasoning model", "LRM", "Large Reasoning Model", "大推理模型", "o1类模型", "慢思考", "long CoT", "长思维链", "测试时扩展", "test-time scaling", "TTS", "inference-time scaling", "test-time compute", "思考模式", "thinking model"],
      "from": "cot"
    },
    {
      "key": "rlvr",
      "name": "可验证奖励强化学习",
      "blurb": "用答案能自动判对错的题目做强化学习，让模型自己练出推理能力。",
      "aka": ["RLVR", "Reinforcement Learning with Verifiable Rewards", "可验证奖励", "推理强化学习", "RL for reasoning", "R1-Zero", "GRPO", "零RL", "zero RL", "结果奖励", "outcome reward", "在策略自蒸馏", "OPSD"],
      "from": "reasoner"
    },
    {
      "key": "context",
      "name": "提示、上下文与记忆",
      "blurb": "模型一次能看的内容有限，该把哪些提示、知识和过往记忆放进去。",
      "aka": ["prompt engineering", "提示工程", "提示词", "context engineering", "上下文工程", "记忆", "memory", "agent memory", "长期记忆", "提示优化", "prompt optimization", "in-context learning"],
      "from": null
    },
    {
      "key": "tools",
      "name": "工具调用与开发接口",
      "blurb": "让模型按格式调用外部函数和API，并给开发者提供搭建智能体的接口。",
      "aka": ["tool use", "tool calling", "function calling", "函数调用", "工具使用", "API调用", "Agents SDK", "智能体开发框架", "structured outputs", "结构化输出", "编排器", "orchestrator"],
      "from": null
    },
    {
      "key": "protocols",
      "name": "智能体协议与生态",
      "blurb": "不同模型、工具和智能体之间怎样用统一的协议和格式接起来。",
      "aka": ["MCP", "Model Context Protocol", "A2A", "Agent2Agent", "智能体协议", "agent protocol", "AGENTS.md", "Skills", "智能体生态", "互操作"],
      "from": "tools",
      "via": "function-calling"
    },
    {
      "key": "agents",
      "name": "智能体架构与多智能体",
      "blurb": "怎样让模型边想边做、循环行动、反思改进，并让多个智能体分工协作。",
      "aka": ["LLM agent", "AI agent", "智能体", "代理", "autonomous agent", "自主智能体", "multi-agent", "多智能体", "MAS", "agent swarm", "智能体群", "swarm", "多智能体编排", "orchestration", "ReAct", "agent framework"],
      "from": null
    },
    {
      "key": "coding",
      "name": "编码智能体",
      "blurb": "从补全一行代码到独立读仓库、改代码、跑测试，连续完成整项软件任务。",
      "aka": ["coding agent", "AI编程", "AI coding", "代码智能体", "软件工程智能体", "SWE agent", "编程助手", "vibe coding", "氛围编程", "agentic coding", "终端智能体", "IDE智能体"],
      "from": null
    },
    {
      "key": "computer-use",
      "name": "电脑与浏览器操作",
      "blurb": "让模型看懂屏幕截图，像人一样点击、输入，操作网页、手机和桌面软件。",
      "aka": ["computer use", "CUA", "computer-use agent", "GUI agent", "GUI智能体", "web agent", "网页智能体", "浏览器智能体", "browser agent", "手机智能体", "mobile agent", "电脑操作", "OS agent"],
      "from": "agents"
    }
  ],
